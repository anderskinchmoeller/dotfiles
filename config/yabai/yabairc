#!/bin/sh
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
CONFIG_DIR="$HOME/.config/yabai"

# Load the scripting addition at every start (login, reboot, service restart).
# Space focus/create/destroy and moving windows between Spaces depend on it.
sudo -n /opt/homebrew/bin/yabai --load-sa 2>/dev/null || echo "yabairc: could not load scripting addition (check /etc/sudoers.d/yabai)" >&2

# Automatically tile ordinary desktops; desktop six uses a full-size stack.
yabai -m config layout bsp
yabai -m config external_bar all:5:0
yabai -m config mouse_follows_focus on
yabai -m config focus_follows_mouse off

# Labels make reloading this configuration idempotent.
for event in window_focused window_created window_destroyed; do
    yabai -m signal --add label="bar-$event" event="$event" action="sketchybar --trigger window_focus --trigger windows_on_spaces"
done
# No minimising: bring minimised windows straight back (needs the scripting addition).
yabai -m signal --add label=no-minimize event=window_minimized action='yabai -m window $YABAI_WINDOW_ID --deminimize'
# No native fullscreen: the green button zooms the window within its Space instead.
yabai -m signal --add label=no-native-fullscreen event=window_resized action="$CONFIG_DIR/no-native-fullscreen.sh"
yabai -m signal --add label=reload-sa event=dock_did_restart action="sudo -n /opt/homebrew/bin/yabai --load-sa"

"$CONFIG_DIR/create_spaces.sh" || echo "yabairc: create_spaces.sh failed" >&2
yabai -m rule --add label=float-utilities app='^(System Settings|System Preferences|Spotify)$' manage=off
yabai -m rule --add label=Safari app='^Safari$' title='^(General|(Tab|Password|Website|Extension)s|AutoFill|Se(arch|curity)|Privacy|Advance)$' manage=off
yabai -m rule --add label='About This Mac' app='System Information' title='About This Mac' manage=off
yabai -m rule --add label='Select file to save to' app='^Inkscape$' title='Select file to save to' manage=off
yabai -m rule --apply float-utilities
yabai -m rule --add label=tile-ghostty app='^[Gg]hostty$' manage=on
yabai -m rule --apply tile-ghostty

# Manual-layout restoration is disabled while automatic tiling owns geometry.
# Saved display layouts remain in ~/.local/state/yabai-layouts/.

# Keep the existing optional window borders without starting duplicate workers.
if command -v borders >/dev/null 2>&1 && ! pgrep -x borders >/dev/null 2>&1; then
    borders active_color=0xff58a6ff inactive_color=0xff58a6ff width=5.0 >/dev/null 2>&1 &
fi
