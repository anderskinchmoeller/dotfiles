# skhd hotkeys for yabai on macOS
#
# Dependencies: yabai, skhd, jq. SketchyBar and JankyBorders are optional.

## Focus Spaces 1–5 on the current display

cmd - 1 : "$HOME/.config/skhd/skhd-helper.sh" focus-space 1
cmd - 2 : "$HOME/.config/skhd/skhd-helper.sh" focus-space 2
cmd - 3 : "$HOME/.config/skhd/skhd-helper.sh" focus-space 3
cmd - 4 : "$HOME/.config/skhd/skhd-helper.sh" focus-space 4
cmd - 5 : "$HOME/.config/skhd/skhd-helper.sh" focus-space 5

## Focus windows, crossing display boundaries when needed

cmd - h : "$HOME/.config/skhd/skhd-helper.sh" focus-direction west
cmd - j : "$HOME/.config/skhd/skhd-helper.sh" focus-direction south
cmd - k : "$HOME/.config/skhd/skhd-helper.sh" focus-direction north
cmd - l : "$HOME/.config/skhd/skhd-helper.sh" focus-direction east

## Move windows

shift + cmd - h : "$HOME/.config/skhd/skhd-helper.sh" move-direction west
shift + cmd - j : "$HOME/.config/skhd/skhd-helper.sh" move-direction south
shift + cmd - k : "$HOME/.config/skhd/skhd-helper.sh" move-direction north
shift + cmd - l : "$HOME/.config/skhd/skhd-helper.sh" move-direction east

shift + cmd - 1 : "$HOME/.config/skhd/skhd-helper.sh" move-to-space 1
shift + cmd - 2 : "$HOME/.config/skhd/skhd-helper.sh" move-to-space 2
shift + cmd - 3 : "$HOME/.config/skhd/skhd-helper.sh" move-to-space 3
shift + cmd - 4 : "$HOME/.config/skhd/skhd-helper.sh" move-to-space 4
shift + cmd - 5 : "$HOME/.config/skhd/skhd-helper.sh" move-to-space 5

shift + cmd - s : yabai -m window --toggle split
cmd - g : yabai -m window --toggle zoom-fullscreen; sketchybar --trigger window_focus

## Navigate and arrange Spaces

shift + lalt - p : yabai -m window --space prev && yabai -m space --focus prev && sketchybar --trigger windows_on_spaces
shift + lalt - n : yabai -m window --space next && yabai -m space --focus next && sketchybar --trigger windows_on_spaces
shift + lalt - x : yabai -m space --mirror x-axis
shift + lalt - y : yabai -m space --mirror y-axis

## Navigate stacks

shift + ctrl - n : yabai -m window --focus stack.next || yabai -m window --focus stack.first
shift + ctrl - p : yabai -m window --focus stack.prev || yabai -m window --focus stack.last

## Resize and balance windows

ctrl + cmd - h : yabai -m window --resize right:-100:0 || yabai -m window --resize left:-100:0
ctrl + cmd - j : yabai -m window --resize bottom:0:100 || yabai -m window --resize top:0:100
ctrl + cmd - k : yabai -m window --resize bottom:0:-100 || yabai -m window --resize top:0:-100
ctrl + cmd - l : yabai -m window --resize right:100:0 || yabai -m window --resize left:100:0

ctrl + lalt - e : yabai -m space --balance
ctrl + lalt - g : yabai -m space --toggle padding; yabai -m space --toggle gap

## Optional JankyBorders controls

ctrl + lalt - b : pkill -x borders 2>/dev/null || true
shift + ctrl + lalt - b : if command -v borders >/dev/null 2>&1 && ! pgrep -x borders >/dev/null; then borders >/dev/null 2>&1 & fi

## Applications

cmd - m         : open -na "Kitty"
cmd + shift - o : open -na "ChatGPT"
cmd + shift - m : open -na "Ghostty"
cmd - return    : open -a "Brave Browser"
cmd + shift - u : open -a "Finder"
cmd - b         : open -a "Visual Studio Code"
cmd - i         : open -a "Spotify"
cmd - o         : open -a "Obsidian"

## Insertion and SketchyBar

lalt - s : yabai -m window --insert east; skhd -k "cmd - n"

shift + cmd - space : sketchybar --bar hidden=toggle
shift + lalt - r : sketchybar --remove '/.*/' && sh "$HOME/.config/sketchybar/sketchybarrc"
shift + cmd - n : "$HOME/.config/skhd/skhd-helper.sh" toggle-bar-margin
